# Example only. Never commit production credentials.
# These names define the target configuration contract for the modernized DB layer.

# Compatibility default: 0 keeps legacy fallback values available.
# Controlled deployments should set this to 1 after providing every required value below.
WYD_DB_REQUIRE_ENV=0

WYD_DB_HOST=127.0.0.1
WYD_DB_PORT=3306
WYD_DB_NAME=wydsite
WYD_DB_USER=wyd_game
WYD_DB_PASSWORD=change-me-locally

# Optional operational settings.
WYD_DB_CONNECT_TIMEOUT_SECONDS=5
WYD_DB_POOL_MIN=1
WYD_DB_POOL_MAX=8
